# Copy to .env and edit.

PORT=4000
NODE_ENV=development

# --- Database ---
# Leave DATABASE_URL empty to use the embedded Postgres (PGlite, stored in ./.data).
# Zero install, great for development. For real Postgres:
# DATABASE_URL=postgres://flypool:flypool@localhost:5432/flypool
DATABASE_URL=

# --- Auth ---
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# In development the OTP is returned in the API response. NEVER true in production.
OTP_DEV_ECHO=true

# --- Flight data ---
# mock | aeroapi
FLIGHT_PROVIDER=mock
# Only needed when FLIGHT_PROVIDER=aeroapi (get it from the FlightAware AeroAPI portal)
AEROAPI_KEY=
# Minutes to reuse a cached flight lookup
FLIGHT_CACHE_MINUTES=10

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:3000
