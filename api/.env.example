# Copy to .env and edit. Production refuses to boot with unsafe values (see src/setup.ts).

PORT=4000
NODE_ENV=development
# Public URL of the website, used in share links and SOS texts
PUBLIC_WEB_URL=http://localhost:3000

# --- Database ---
# Leave DATABASE_URL empty to use the embedded Postgres (PGlite, stored in ./.data). Zero install, great for development.
# Production: a managed Postgres (Neon, Supabase, RDS...). With several API instances, live updates use LISTEN/NOTIFY,
# so use a direct or session-mode pooler URL (not transaction-mode PgBouncer).
# DATABASE_URL=postgres://flypool:flypool@localhost:5432/flypool
DATABASE_URL=
DATABASE_SSL=false
DB_POOL_MAX=10

# --- Auth ---
# Production: a long random string. openssl rand -hex 32
JWT_SECRET=change-me-in-production
# Access tokens are short; the website renews them with a refresh token (rotated on every use)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
# Development only: the OTP is returned in the API response instead of an SMS. Refused in production.
OTP_DEV_ECHO=true

# --- SMS (OTP codes and SOS alerts) ---
# console | msg91 | twilio
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_ALERT_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Flight data ---
# mock | aeroapi
FLIGHT_PROVIDER=mock
AEROAPI_KEY=
# Minutes to reuse a cached flight lookup, and how often active flights are re-checked for delays
FLIGHT_CACHE_MINUTES=10
FLIGHT_POLL_MINUTES=5

# --- Background jobs (expire old requests, flight delay updates, cleanup) ---
JOBS_ENABLED=true

# --- HTTP ---
# Comma separated list of website origins
CORS_ORIGINS=http://localhost:3000
# Behind a load balancer / reverse proxy: number of proxy hops to trust (needed for correct rate limiting)
TRUST_PROXY=
RATE_LIMIT=120
OTP_RATE_LIMIT=5
# Swagger UI at /docs is off in production unless this is true
SWAGGER=false
# json logs (always on in production)
LOG_FORMAT=
