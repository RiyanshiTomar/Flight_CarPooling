# Where the website finds the API. Copy this file to .env.local and edit.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this website (used for link previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "mock" to run the whole website offline on in-memory fake data (no backend needed).
# Demo login code in mock mode: 123456
# NEXT_PUBLIC_DATA_SOURCE=mock
